# Copy to .env and fill in. Never commit .env.

# ===== Storage =====
# sqlite | postgres
XUEQIU_STORAGE_BACKEND=sqlite
XUEQIU_SQLITE_PATH=data/xueqiu.db

# Only needed when XUEQIU_STORAGE_BACKEND=postgres
XUEQIU_PG_DSN=postgresql://user:pass@localhost:5432/xueqiu

# ===== Browser =====
# Path to Chrome/Chromium binary (auto-detect if empty)
XUEQIU_BROWSER_PATH=
# true | false — show browser window for first run / debugging
XUEQIU_HEADLESS=true

# ===== Optional: pre-logged-in cookie =====
# Paste full cookie string from logged-in browser to extend token lifetime
XUEQIU_COOKIE_STRING=

# ===== Logging =====
# DEBUG | INFO | WARNING | ERROR
XUEQIU_LOG_LEVEL=INFO
